# WhatsApp Ledger Sender - Environment Configuration
# Copy this file or the respective server/.env.example and client/.env.example

# --- Server Configuration (.env in /server) ---
# PORT=5000
# NODE_ENV=development
# CLIENT_URL=http://localhost:5173
# JWT_SECRET=your_jwt_secret_here
# DATABASE_PATH=./database/app.db
# UPLOADS_DIR=../uploads

# --- Gupshup WhatsApp Business API ---
# GUPSHUP_APP_NAME=your_app_name
# GUPSHUP_API_KEY=your_api_key
# GUPSHUP_BASE_URL=https://api.gupshup.io/wa/api/v1
# GUPSHUP_SOURCE_PHONE=919876543210

# --- Tally Prime Integration ---
# TALLY_API_URL=http://localhost:9000
# TALLY_COMPANY_NAME=Your Company Name

# --- Client Configuration (.env in /client) ---
# VITE_API_URL=http://localhost:5000/api
# VITE_SOCKET_URL=http://localhost:5000
# VITE_FIREBASE_API_KEY=your_key
# VITE_FIREBASE_AUTH_DOMAIN=your_domain.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your_project_id
